# Docker image to deploy
PSFREE_IMAGE=espressomatic/psfree_docker:latest

# Container listen port (inside container)
PSFREE_PORT=80

# Host folder to persist data (relative to this compose file)
PSFREE_DATA_DIR=./data

# Macvlan settings (default mode)
PSFREE_IP=192.168.1.50
MACVLAN_PARENT=eth0
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1

# Bridge mode (optional)
# Uncomment and adjust if using bridge mode with published ports.
# HOST_PORT=8080
